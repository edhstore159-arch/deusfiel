# ============================================================
# Escritório Kênia - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# Docker Compose will load these values automatically
# ============================================================

# ============================================================
# Supabase Configuration
# ============================================================
# Get these values from your Supabase dashboard
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# Google Maps Configuration
# ============================================================
# Get this from: https://console.cloud.google.com/

VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=AIzaSy...

# ============================================================
# Backend Configuration
# ============================================================
# URL where the frontend can reach the backend API
# For Docker: http://backend:3000 (internal)
# For local dev: http://localhost:3000

VITE_BACKEND_URL=http://localhost:3000

# ============================================================
# Runtime Environment
# ============================================================
NODE_ENV=production

# Port for Express backend (default: 3000)
PORT=3000

# ============================================================
# AI Providers - Zen (OpenCode)
# ============================================================
# Get from: https://opencode.ai
ZEN_API_KEY=sk-...

# ============================================================
# AI Providers - FCC (Free Claude Code)
# ============================================================
# Run locally: free-claude-code server
FCC_BASE_URL=http://localhost:11111
FCC_AUTH_TOKEN=your-fcc-auth-token
FCC_MODEL=claude-3-freecc-no-thinking/nvidia_nim/nvidia/nemotron-3-super-120b-a12b
FCC_ENABLED=false
FCC_TIMEOUT_MS=60000

# ============================================================
# AI Providers - OpenRouter (Free Models)
# ============================================================
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ============================================================
# AI Providers - Groq (Whisper Transcription)
# ============================================================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ============================================================
# AI Providers - Gemini (Transcription & Images)
# ============================================================
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# ============================================================
# AI Providers - Ollama (Local LLM)
# ============================================================
# Run locally: ollama serve
# For ngrok tunnel: https://ngrok.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_FALLBACK_MODEL=

# ============================================================
# AI Providers - Emergent / Lovable
# ============================================================
EMERGENT_API_KEY=...
LOVABLE_API_KEY=...

# ============================================================
# Database - MongoDB
# ============================================================
MONGO_URL=mongodb://localhost:27017
DB_NAME=espirito_santo

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================================
# WhatsApp / Baileys
# ============================================================
WHATSAPP_ENABLED=true
BAILEYS_PORT=8002
BAILEYS_INTERNAL_TOKEN=your-baileys-internal-token

# ============================================================
# NVIDIA NIM
# ============================================================
NVIDIA_NIM_API_KEY=nvapi-...